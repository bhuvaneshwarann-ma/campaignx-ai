# CAMPAIGNX AI — Environment Configuration

# Execution Mode (offline | online)
MODE=offline
APP_ENV=development
DEBUG=true

# Database (PostgreSQL default, falls back to SQLite if PostgreSQL is unavailable)
DATABASE_URL=sqlite:///./campaignx.db
# DATABASE_URL=postgresql://campaignx:campaignx_secret@localhost:5432/campaignx_db
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET=super_secret_campaignx_jwt_key_change_in_production_32bytes_minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
PII_HMAC_KEY=campaignx_pii_hmac_secret_key_32bytes_min

# AI Threat Intelligence & Investigation Providers
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
FRONTEND_URL=http://localhost:5173
